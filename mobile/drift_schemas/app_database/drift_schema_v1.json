  "fixed_sql": [
    {
      "name": "workspaces",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workspaces\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"icon\" TEXT NOT NULL DEFAULT '🚀', \"type\" TEXT NOT NULL DEFAULT 'private', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "folders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"folders\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"workspace_id\" TEXT NOT NULL REFERENCES workspaces (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"name\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"workspace_id\" TEXT NOT NULL REFERENCES workspaces (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"status\" TEXT NOT NULL DEFAULT 'planning', \"priority\" TEXT NOT NULL DEFAULT 'medium', \"color\" TEXT NOT NULL DEFAULT 'indigo', \"start_date\" TEXT NULL, \"due_date\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"workspace_id\" TEXT NOT NULL REFERENCES workspaces (id) ON DELETE CASCADE, \"project_id\" TEXT NULL REFERENCES projects (id) ON DELETE SET NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"status\" TEXT NOT NULL DEFAULT 'todo', \"priority\" TEXT NOT NULL DEFAULT 'medium', \"due_date\" TEXT NULL, \"due_time\" TEXT NULL, \"recurrence\" TEXT NULL, \"tags\" TEXT NOT NULL DEFAULT '[]', \"sort_order\" REAL NOT NULL DEFAULT 0.0, \"completed_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "subtasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subtasks\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"is_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_done\" IN (0, 1)), \"sort_order\" REAL NOT NULL DEFAULT 0.0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pages\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"workspace_id\" TEXT NOT NULL REFERENCES workspaces (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"folder_id\" TEXT NULL REFERENCES folders (id) ON DELETE SET NULL, \"project_id\" TEXT NULL REFERENCES projects (id) ON DELETE SET NULL, \"title\" TEXT NOT NULL DEFAULT '', \"content\" TEXT NULL, \"content_format\" TEXT NOT NULL DEFAULT 'quill_delta', \"plain_text\" TEXT NOT NULL DEFAULT '', \"tags\" TEXT NOT NULL DEFAULT '[]', \"pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pinned\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "drawings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drawings\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"workspace_id\" TEXT NOT NULL REFERENCES workspaces (id) ON DELETE CASCADE, \"folder_id\" TEXT NULL REFERENCES folders (id) ON DELETE SET NULL, \"project_id\" TEXT NULL REFERENCES projects (id) ON DELETE SET NULL, \"title\" TEXT NOT NULL DEFAULT '', \"scene\" TEXT NOT NULL DEFAULT '{}', \"thumbnail\" BLOB NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
